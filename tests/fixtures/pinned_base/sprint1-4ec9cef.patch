+        if (lstat(p, &st) != 0) continue;
+        if (S_ISDIR(st.st_mode)) { find_twins(p, ino, dv, self, out, cap, n); continue; }
+        if (st.st_ino != ino || st.st_dev != dv || strcmp(norm(p), self) == 0) continue;
+        size_t l = strlen(out);
