+void host_crit_enter(void);
+void host_crit_exit(void);
+#define portENTER_CRITICAL_SAFE(m) ((void)(m), host_crit_enter())
+#define portEXIT_CRITICAL_SAFE(m)  ((void)(m), host_crit_exit())
