{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambyte.invalid/schemas/base-state-output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "settled",
    "base_sha",
    "latest_release",
    "commits",
    "unresolved",
    "errors",
    "invalid_recovery_markers"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "ok": { "const": true },
    "settled": { "type": "boolean" },
    "base_sha": {
      "$ref": "release-analysis.schema.json#/$defs/sha"
    },
    "latest_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "version", "target_sha"],
      "properties": {
        "tag": { "type": "string" },
        "version": { "type": "string" },
        "target_sha": {
          "$ref": "release-analysis.schema.json#/$defs/sha"
        }
      }
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha",
          "pull_request_number",
          "title",
          "state",
          "decision",
          "recovery_of_sha"
        ],
        "properties": {
          "sha": {
            "$ref": "release-analysis.schema.json#/$defs/sha"
          },
          "pull_request_number": {
            "type": ["integer", "null"]
          },
          "title": {
            "type": "string"
          },
          "state": {
            "enum": [
              "accepted-baseline",
              "settled-no-release",
              "unresolved-release",
              "aborted-release",
              "verified-recovery"
            ]
          },
          "decision": {
            "anyOf": [
              { "$ref": "release-analysis.schema.json#/$defs/releaseDecision" },
              { "type": "null" }
            ]
          },
          "recovery_of_sha": {
            "anyOf": [
              { "$ref": "release-analysis.schema.json#/$defs/sha" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha", "pull_request_number", "title", "bump"],
        "properties": {
          "sha": {
            "$ref": "release-analysis.schema.json#/$defs/sha"
          },
          "pull_request_number": {
            "type": "integer"
          },
          "title": { "type": "string" },
          "bump": { "enum": ["major", "minor", "patch"] }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "sha", "message"],
        "properties": {
          "code": { "type": "string" },
          "sha": {
            "anyOf": [
              { "$ref": "release-analysis.schema.json#/$defs/sha" },
              { "type": "null" }
            ]
          },
          "message": { "type": "string" }
        }
      }
    },
    "invalid_recovery_markers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "target_sha", "reason"],
        "properties": {
          "name": { "type": "string" },
          "target_sha": {
            "$ref": "release-analysis.schema.json#/$defs/sha"
          },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
