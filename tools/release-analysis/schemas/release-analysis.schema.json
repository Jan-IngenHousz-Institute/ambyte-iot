{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambyte.invalid/schemas/release-analysis.schema.json",
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title", "url"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\r\\n]+$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "parsedTitle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scope", "subject", "breaking"],
      "properties": {
        "type": {
          "enum": [
            "feat",
            "fix",
            "perf",
            "revert",
            "docs",
            "style",
            "chore",
            "refactor",
            "test",
            "build",
            "ci"
          ]
        },
        "scope": {
          "type": ["string", "null"]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "breaking": {
          "type": "boolean"
        }
      }
    },
    "releaseDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "bump", "kind", "reason"],
      "properties": {
        "release": {
          "type": "boolean"
        },
        "bump": {
          "enum": ["major", "minor", "patch", null]
        },
        "kind": {
          "enum": ["release", "no-release", "recovery"]
        },
        "reason": {
          "enum": [
            "breaking-change",
            "type-feat",
            "type-fix",
            "type-perf",
            "type-revert",
            "no-release-type",
            "verified-recovery-revert"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "release": { "const": true }
            }
          },
          "then": {
            "properties": {
              "bump": { "enum": ["major", "minor", "patch"] },
              "kind": { "const": "release" }
            }
          },
          "else": {
            "properties": {
              "bump": { "const": null },
              "kind": { "enum": ["no-release", "recovery"] }
            }
          }
        }
      ]
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous", "next", "tag"],
      "properties": {
        "previous": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "next": {
          "type": ["string", "null"],
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "tag": {
          "type": ["string", "null"],
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "markdown", "sha256"],
      "properties": {
        "format": {
          "const": "text/markdown"
        },
        "markdown": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\n$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "candidateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pull_request_number",
        "pull_request_url",
        "title",
        "head_sha",
        "base_sha",
        "tree_sha",
        "latest_release_tag",
        "release_tag",
        "notes_sha256",
        "recovery_of_sha"
      ],
      "properties": {
        "pull_request_number": {
          "type": "integer",
          "minimum": 1
        },
        "pull_request_url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string"
        },
        "head_sha": {
          "$ref": "#/$defs/sha"
        },
        "base_sha": {
          "$ref": "#/$defs/sha"
        },
        "tree_sha": {
          "$ref": "#/$defs/sha"
        },
        "latest_release_tag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "release_tag": {
          "type": ["string", "null"],
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "notes_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recovery_of_sha": {
          "anyOf": [
            { "$ref": "#/$defs/sha" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
