{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambyte.invalid/schemas/base-state-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base_sha",
    "first_parent_commits",
    "release_tags",
    "recovery_markers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "base_sha": {
      "$ref": "release-analysis.schema.json#/$defs/sha"
    },
    "first_parent_commits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha", "parent_sha", "tree_sha", "subject"],
        "properties": {
          "sha": {
            "$ref": "release-analysis.schema.json#/$defs/sha"
          },
          "parent_sha": {
            "anyOf": [
              { "$ref": "release-analysis.schema.json#/$defs/sha" },
              { "type": "null" }
            ]
          },
          "tree_sha": {
            "$ref": "release-analysis.schema.json#/$defs/sha"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\r\\n]+$"
          },
          "pull_request": {
            "$ref": "release-analysis.schema.json#/$defs/pullRequest"
          },
          "recovery": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "failed_sha",
              "failed_parent_sha",
              "expected_revert_tree_sha"
            ],
            "properties": {
              "failed_sha": {
                "$ref": "release-analysis.schema.json#/$defs/sha"
              },
              "failed_parent_sha": {
                "$ref": "release-analysis.schema.json#/$defs/sha"
              },
              "expected_revert_tree_sha": {
                "$ref": "release-analysis.schema.json#/$defs/sha"
              }
            }
          }
        }
      }
    },
    "release_tags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "target_sha", "published", "immutable"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "target_sha": {
            "$ref": "release-analysis.schema.json#/$defs/sha"
          },
          "published": {
            "type": "boolean"
          },
          "immutable": {
            "type": "boolean"
          }
        }
      }
    },
    "recovery_markers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "target_sha", "protected"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^release-aborted/[0-9a-f]{40}$"
          },
          "target_sha": {
            "$ref": "release-analysis.schema.json#/$defs/sha"
          },
          "protected": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
