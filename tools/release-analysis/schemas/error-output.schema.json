{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambyte.invalid/schemas/error-output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ok", "error"],
  "properties": {
    "schema_version": { "const": 1 },
    "ok": { "const": false },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "details"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": { "type": "array" }
      }
    }
  }
}
