{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambyte.invalid/schemas/candidate-analysis-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pull_request", "candidate", "base"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pull_request": {
      "$ref": "release-analysis.schema.json#/$defs/pullRequest"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_sha", "base_sha", "tree_sha"],
      "properties": {
        "head_sha": {
          "$ref": "release-analysis.schema.json#/$defs/sha"
        },
        "base_sha": {
          "$ref": "release-analysis.schema.json#/$defs/sha"
        },
        "tree_sha": {
          "$ref": "release-analysis.schema.json#/$defs/sha"
        }
      }
    },
    "base": {
      "$ref": "base-state-input.schema.json"
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failed_sha",
        "failed_parent_sha",
        "expected_revert_tree_sha"
      ],
      "properties": {
        "failed_sha": {
          "$ref": "release-analysis.schema.json#/$defs/sha"
        },
        "failed_parent_sha": {
          "$ref": "release-analysis.schema.json#/$defs/sha"
        },
        "expected_revert_tree_sha": {
          "$ref": "release-analysis.schema.json#/$defs/sha"
        }
      }
    }
  }
}
