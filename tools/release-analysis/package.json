{
  "name": "@ambyte/release-analysis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pure deterministic release analysis for Ambyte firmware",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "npm test && npm run test:locked",
    "test:locked": "npm ci --ignore-scripts --dry-run"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "semver": "7.8.5"
  }
}
