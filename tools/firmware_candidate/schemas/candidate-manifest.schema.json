{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jii.example/schemas/firmware-candidate-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_name", "repository", "pull_request", "source", "analysis", "workflow", "provisioning", "tool_versions", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_name": {"type": "string", "pattern": "^firmware-candidate-pr-[1-9][0-9]*-[0-9a-f]{12}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_sha", "base_sha", "tree_sha"],
      "properties": {
        "head_sha": {"$ref": "#/$defs/git_sha"},
        "base_sha": {"$ref": "#/$defs/git_sha"},
        "tree_sha": {"$ref": "#/$defs/git_sha"}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "release_version", "firmware_version", "notes_sha256", "latest_release_tag", "recovery_of_sha"],
      "properties": {
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["release", "bump", "kind", "reason"],
          "properties": {
            "release": {"type": "boolean"},
            "bump": {"enum": ["major", "minor", "patch", null]},
            "kind": {"enum": ["release", "no-release", "recovery"]},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        "release_version": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "firmware_version": {"type": "string", "minLength": 1, "maxLength": 31},
        "notes_sha256": {"$ref": "#/$defs/sha256"},
        "latest_release_tag": {
          "type": "string",
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "recovery_of_sha": {"anyOf": [{"$ref": "#/$defs/git_sha"}, {"type": "null"}]}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "run_id", "run_attempt"],
      "properties": {
        "sha": {"$ref": "#/$defs/git_sha"},
        "run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"type": "integer", "minimum": 1}
      }
    },
    "provisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nvs", "device_secrets"],
      "properties": {"nvs": {"const": "excluded"}, "device_secrets": {"const": "excluded"}}
    },
    "tool_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platformio_core", "platformio_platform", "esp_idf", "esp_idf_package", "esptool", "esptool_package"],
      "properties": {
        "platformio_core": {"const": "6.1.19"},
        "platformio_platform": {"const": "espressif32@6.12.0"},
        "esp_idf": {"const": "5.5.0"},
        "esp_idf_package": {"const": "3.50500.0"},
        "esptool": {"const": "4.9.0"},
        "esptool_package": {"const": "2.40900.250804"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {"type": "string", "pattern": "^[^/\\\\]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
