{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jii.example/schemas/firmware-flash-plan-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chip", "esptool", "images"],
  "properties": {
    "schema_version": {"const": 1},
    "chip": {"const": "esp32s3"},
    "esptool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_version", "version", "command"],
      "properties": {
        "package_version": {"const": "2.40900.250804"},
        "version": {"const": "4.9.0"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "images": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["offset", "path", "role", "sha256", "size"],
        "properties": {
          "offset": {"type": "string", "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"},
          "path": {"enum": ["bootloader.bin", "firmware.bin", "partition-table.bin", "ota_data_initial.bin"]},
          "role": {"enum": ["bootloader", "app", "partition-table", "otadata"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
